{
  "name": "pokemontcgpricelookup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone SEARCHDOG Pokemon TCG price lookup, tracking and metrics",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
